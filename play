<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>لعبة المفرد والجمع الممتعة</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Cairo', sans-serif;
            touch-action: manipulation;
        }
        .dragging {
            opacity: 0.5;
            transform: scale(0.95);
        }
        /* Custom scrollbar for mobile safety */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb {
            background: #d8b4fe;
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #c084fc;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-pink-100 via-purple-100 to-sky-100 min-h-screen flex flex-col items-center justify-between p-3 sm:p-6 transition-colors duration-500" id="mainContainer">

    <header class="w-full max-w-4xl flex flex-col sm:flex-row justify-between items-center bg-white/90 backdrop-blur-md shadow-lg rounded-2xl p-3 sm:p-4 mb-4 sm:mb-6 border-2 border-pink-200 gap-3">
        <div class="flex items-center gap-3">
            <span class="text-3xl sm:text-4xl">⭐</span>
            <h1 class="text-xl sm:text-2xl md:text-3xl font-black text-purple-700 text-center sm:text-right">لعبة المفرد والجمع</h1>
        </div>
        <div class="flex flex-wrap justify-center gap-2 w-full sm:w-auto">
            <button onclick="resetGame()" class="flex-1 sm:flex-none bg-amber-400 hover:bg-amber-500 text-amber-950 font-bold px-3 sm:px-4 py-2 rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer text-xs sm:text-base">
                🔄 بدء من جديد
            </button>
            <button onclick="openAdminModal()" class="flex-1 sm:flex-none bg-purple-600 hover:bg-purple-700 text-white font-bold px-3 sm:px-4 py-2 rounded-xl shadow-md transition-all flex items-center justify-center gap-2 cursor-pointer text-xs sm:text-base">
                ⚙️ إدارة الكلمات
            </button>
        </div>
    </header>

    <main class="w-full max-w-4xl flex-1 flex flex-col items-center justify-center gap-4 sm:gap-6">
        
        <!-- Score & Instructions -->
        <div class="w-full bg-white/90 px-4 sm:px-6 py-3 rounded-2xl shadow border border-purple-100 text-center">
            <p class="text-gray-700 font-bold text-sm sm:text-lg">اسحب الكلمة أو اضغط عليها ثم اضغط في الصندوق المناسب (مفرد أو جمع)!</p>
            <div class="text-purple-600 font-extrabold mt-1 text-sm sm:text-base">النقاط: <span id="score">0</span> / <span id="totalWords">0</span></div>
        </div>

        <!-- Word Pool Container -->
        <div class="w-full bg-white/85 backdrop-blur-md rounded-3xl p-4 sm:p-6 shadow-xl border-4 border-dashed border-purple-300 min-h-[120px] sm:min-h-[140px] flex flex-wrap gap-2 sm:gap-3 items-center justify-center" id="wordPool">
            <!-- Words will be dynamically injected here -->
        </div>

        <!-- Drop Zones Container (Singular & Plural) -->
        <div class="w-full grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
            
            <!-- Singular Drop Zone -->
            <div class="bg-sky-50 rounded-3xl p-4 sm:p-6 shadow-lg border-4 border-sky-300 flex flex-col items-center min-h-[200px] sm:min-h-[260px] transition-all"
                 ondragover="allowDrop(event)" ondragleave="removeHighlight(event)" ondrop="dropWord(event, 'singular')" onclick="selectZone('singular')">
                <div class="flex items-center gap-2 mb-3 sm:mb-4">
                    <span class="text-2xl sm:text-3xl">📘</span>
                    <h2 class="text-xl sm:text-2xl font-black text-sky-700">مفرد</h2>
                </div>
                <div id="singularZone" class="w-full flex-1 flex flex-wrap gap-2 items-center justify-center border-2 border-dashed border-sky-200 rounded-2xl p-3 bg-white/60">
                    <span class="text-sky-400 text-xs sm:text-sm font-semibold select-none">ضَع الكلمات المفردة هنا</span>
                </div>
            </div>

            <!-- Plural Drop Zone -->
            <div class="bg-pink-50 rounded-3xl p-4 sm:p-6 shadow-lg border-4 border-pink-300 flex flex-col items-center min-h-[200px] sm:min-h-[260px] transition-all"
                 ondragover="allowDrop(event)" ondragleave="removeHighlight(event)" ondrop="dropWord(event, 'plural')" onclick="selectZone('plural')">
                <div class="flex items-center gap-2 mb-3 sm:mb-4">
                    <span class="text-2xl sm:text-3xl">📚</span>
                    <h2 class="text-xl sm:text-2xl font-black text-pink-700">جمع</h2>
                </div>
                <div id="pluralZone" class="w-full flex-1 flex flex-wrap gap-2 items-center justify-center border-2 border-dashed border-pink-200 rounded-2xl p-3 bg-white/60">
                    <span class="text-pink-400 text-xs sm:text-sm font-semibold select-none">ضَع كلمات الجمع هنا</span>
                </div>
            </div>

        </div>

    </main>

    <footer class="w-full text-center mt-6 text-gray-500 text-xs sm:text-sm font-semibold">
        صُمم خصيصاً لطالبات الصف الثاني الابتدائي الجميلات ✨
    </footer>

    <div id="passwordModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center p-4 z-50">
        <div class="bg-white rounded-3xl p-6 max-w-md w-full shadow-2xl border-4 border-purple-200 flex flex-col gap-4">
            <h3 class="text-xl font-bold text-purple-800 text-center">🔑 إدخال رمز الدخول للإدارة</h3>
            <p class="text-gray-600 text-sm text-center">الرمز الافتراضي هو: <span class="bg-purple-100 text-purple-700 px-2 py-1 rounded font-bold">ftm</span></p>
            <input type="password" id="passwordInput" placeholder="أدخل رمز الدخول..." class="border-2 border-purple-300 rounded-2xl px-4 py-3 outline-none focus:border-purple-600 text-center text-lg font-bold">
            <div class="flex gap-3 mt-2">
                <button onclick="closePasswordModal()" class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-3 rounded-xl transition cursor-pointer">إلغاء</button>
                <button onclick="verifyPassword()" class="flex-1 bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 rounded-xl transition cursor-pointer">دخول</button>
            </div>
        </div>
    </div>

    <div id="adminModal" class="fixed inset-0 bg-black/50 backdrop-blur-sm hidden items-center justify-center p-4 z-50 overflow-y-auto">
        <div class="bg-white rounded-3xl p-4 sm:p-6 max-w-2xl w-full shadow-2xl border-4 border-purple-200 flex flex-col gap-5 my-8">
            <div class="flex justify-between items-center border-b pb-3">
                <h3 class="text-xl sm:text-2xl font-black text-purple-800">⚙️ إدارة الكلمات (إضافة وحذف)</h3>
                <button onclick="closeAdminModal()" class="text-gray-400 hover:text-gray-600 text-2xl font-bold cursor-pointer">&times;</button>
            </div>

            <!-- Add Word Form -->
            <div class="bg-purple-50 p-4 rounded-2xl border border-purple-200 flex flex-col gap-3">
                <h4 class="font-bold text-purple-700 text-sm sm:text-base">إضافة زوج كلمات جديد (مفرد وجمعه):</h4>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <input type="text" id="newSingular" placeholder="كلمة المفرد (مثال: كتاب)" class="bg-white border-2 border-purple-200 rounded-xl px-3 py-2 outline-none focus:border-purple-500 text-sm sm:text-base">
                    <input type="text" id="newPlural" placeholder="كلمة الجمع (مثال: كتب)" class="bg-white border-2 border-purple-200 rounded-xl px-3 py-2 outline-none focus:border-purple-500 text-sm sm:text-base">
                </div>
                <button onclick="addNewWordPair()" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-2 rounded-xl transition shadow cursor-pointer text-sm sm:text-base">حفظ الإضافة</button>
            </div>

            <!-- Words List Table -->
            <div class="flex flex-col gap-2">
                <h4 class="font-bold text-gray-700 text-sm sm:text-base">الكلمات الحالية في اللعبة:</h4>
                <div class="max-h-52 overflow-y-auto border border-gray-200 rounded-2xl p-2 bg-gray-50 flex flex-col gap-2" id="adminWordsList">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <div class="flex justify-end pt-2 border-t">
                <button onclick="closeAdminModal()" class="bg-purple-600 hover:bg-purple-700 text-white font-bold px-6 py-2 rounded-xl transition cursor-pointer text-sm sm:text-base">إغلاق وحفظ</button>
            </div>
        </div>
    </div>

    <script>
        // Web Audio API sound generator for cheer and error feedback
        let audioCtx = null;

        function initAudio() {
            if (!audioCtx) {
                audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            }
        }

        // Play success cheer sound (harmonious ascending cheerful chimes)
        function playSuccessSound() {
            try {
                initAudio();
                if (!audioCtx) return;
                const now = audioCtx.currentTime;
                const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'triangle';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.08);
                    
                    gain.gain.setValueAtTime(0.2, now + idx * 0.08);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.08 + 0.3);
                    
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    
                    osc.start(now + idx * 0.08);
                    osc.stop(now + idx * 0.08 + 0.3);
                });
            } catch(e) {
                console.log('Audio error:', e);
            }
        }

        // Play error warning sound (gentle double low tone)
        function playErrorSound() {
            try {
                initAudio();
                if (!audioCtx) return;
                const now = audioCtx.currentTime;
                const notes = [220, 185]; // A3, F#3
                notes.forEach((freq, idx) => {
                    const osc = audioCtx.createOscillator();
                    const gain = audioCtx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(freq, now + idx * 0.12);
                    
                    gain.gain.setValueAtTime(0.15, now + idx * 0.12);
                    gain.gain.exponentialRampToValueAtTime(0.001, now + idx * 0.12 + 0.25);
                    
                    osc.connect(gain);
                    gain.connect(audioCtx.destination);
                    
                    osc.start(now + idx * 0.12);
                    osc.stop(now + idx * 0.12 + 0.25);
                });
            } catch(e) {
                console.log('Audio error:', e);
            }
        }

        // Default word pairs database
        let defaultWords = [
            { id: 1, singular: "قلم", plural: "أقلام" },
            { id: 2, singular: "كتاب", plural: "كتب" },
            { id: 3, singular: "وردة", plural: "ورود" },
            { id: 4, singular: "ولد", plural: "أولاد" },
            { id: 5, singular: "بنت", plural: "بنات" },
            { id: 6, singular: "تفاحة", plural: "تفاح" }
        ];

        let wordsData = [];
        let activeWords = [];
        let selectedWordId = null;
        let score = 0;

        // Initialize game on load
        window.onload = function() {
            loadWordsFromStorage();
            initGame();
        };

        function loadWordsFromStorage() {
            const saved = localStorage.getItem('game_words_data');
            if (saved) {
                try {
                    wordsData = JSON.parse(saved);
                } catch(e) {
                    wordsData = [...defaultWords];
                }
            } else {
                wordsData = [...defaultWords];
            }
        }

        function saveWordsToStorage() {
            localStorage.setItem('game_words_data', JSON.stringify(wordsData));
        }

        function initGame() {
            score = 0;
            updateScoreDisplay();
            activeWords = [];
            wordsData.forEach(item => {
                activeWords.push({ id: item.id + '_s', wordId: item.id, text: item.singular, type: 'singular', placed: false });
                activeWords.push({ id: item.id + '_p', wordId: item.id, text: item.plural, type: 'plural', placed: false });
            });
            // Shuffle
            activeWords.sort(() => Math.random() - 0.5);
            document.getElementById('totalWords').innerText = activeWords.length;
            
            // Clear zones
            document.getElementById('singularZone').innerHTML = '<span class="text-sky-400 text-xs sm:text-sm font-semibold select-none">ضَع الكلمات المفردة هنا</span>';
            document.getElementById('pluralZone').innerHTML = '<span class="text-pink-400 text-xs sm:text-sm font-semibold select-none">ضَع كلمات الجمع هنا</span>';
            
            renderWordPool();
        }

        function renderWordPool() {
            const pool = document.getElementById('wordPool');
            pool.innerHTML = '';
            
            const unplacedWords = activeWords.filter(w => !w.placed);
            if (unplacedWords.length === 0) {
                pool.innerHTML = '<div class="text-purple-600 font-bold text-base sm:text-lg text-center animate-bounce">🎉 رائع جداً! لقد أكملتِ جميع الكلمات بنجاح يا بطلة! ⭐</div>';
                return;
            }

            unplacedWords.forEach(word => {
                const btn = document.createElement('div');
                btn.id = word.id;
                btn.className = `px-4 sm:px-5 py-2.5 sm:py-3 bg-white border-2 border-purple-300 text-purple-800 font-extrabold text-base sm:text-lg rounded-2xl shadow-md cursor-grab active:cursor-grabbing hover:bg-purple-50 transition-all select-none ${selectedWordId === word.id ? 'ring-4 ring-amber-400 bg-amber-50 scale-105' : ''}`;
                btn.innerText = word.text;
                btn.draggable = true;
                
                // Drag events
                btn.addEventListener('dragstart', (e) => {
                    initAudio();
                    e.dataTransfer.setData('text/plain', word.id);
                    setTimeout(() => btn.classList.add('opacity-50'), 0);
                });
                btn.addEventListener('dragend', () => {
                    btn.classList.remove('opacity-50');
                });

                // Click selection fallback
                btn.addEventListener('click', (e) => {
                    initAudio();
                    e.stopPropagation();
                    selectWord(word.id);
                });

                pool.appendChild(btn);
            });
        }

        function selectWord(id) {
            if (selectedWordId === id) {
                selectedWordId = null;
            } else {
                selectedWordId = id;
            }
            renderWordPool();
        }

        function allowDrop(e) {
            e.preventDefault();
        }

        function removeHighlight(e) {
            // Optional cleanup
        }

        function dropWord(e, targetType) {
            e.preventDefault();
            const wordId = e.dataTransfer.getData('text/plain');
            if (wordId) {
                checkAnswer(wordId, targetType);
            }
        }

        function selectZone(targetType) {
            if (selectedWordId) {
                checkAnswer(selectedWordId, targetType);
                selectedWordId = null;
            }
        }

        function checkAnswer(wordUniqueId, targetType) {
            const wordObj = activeWords.find(w => w.id === wordUniqueId);
            if (!wordObj || wordObj.placed) return;

            const mainContainer = document.getElementById('mainContainer');

            if (wordObj.type === targetType) {
                // Correct Answer! Play success cheer sound
                playSuccessSound();
                wordObj.placed = true;
                score++;
                updateScoreDisplay();

                // Flash Green
                mainContainer.classList.remove('bg-gradient-to-br', 'from-pink-100', 'via-purple-100', 'to-sky-100', 'bg-red-300');
                mainContainer.classList.add('bg-green-300');
                setTimeout(() => {
                    mainContainer.classList.remove('bg-green-300');
                    mainContainer.classList.add('bg-gradient-to-br', 'from-pink-100', 'via-purple-100', 'to-sky-100');
                }, 700);

                // Append to zone
                const zoneContainer = document.getElementById(targetType === 'singular' ? 'singularZone' : 'pluralZone');
                const placeholder = zoneContainer.querySelector('span');
                if (placeholder) placeholder.remove();

                const placedEl = document.createElement('div');
                placedEl.className = `px-3 sm:px-4 py-1.5 sm:py-2 ${targetType === 'singular' ? 'bg-sky-100 border-sky-400 text-sky-900' : 'bg-pink-100 border-pink-400 text-pink-900'} border-2 font-bold rounded-xl shadow-sm text-sm sm:text-base animate-pulse`;
                placedEl.innerText = wordObj.text;
                zoneContainer.appendChild(placedEl);

                renderWordPool();
            } else {
                // Incorrect Answer! Play error sound
                playErrorSound();

                // Flash Red
                mainContainer.classList.remove('bg-gradient-to-br', 'from-pink-100', 'via-purple-100', 'to-sky-100', 'bg-green-300');
                mainContainer.classList.add('bg-red-300');
                setTimeout(() => {
                    mainContainer.classList.remove('bg-red-300');
                    mainContainer.classList.add('bg-gradient-to-br', 'from-pink-100', 'via-purple-100', 'to-sky-100');
                }, 700);

                renderWordPool();
            }
        }

        function updateScoreDisplay() {
            document.getElementById('score').innerText = score;
        }

        function resetGame() {
            initGame();
        }

        // Admin Management functions
        function openAdminModal() {
            document.getElementById('passwordModal').classList.remove('hidden');
            document.getElementById('passwordModal').classList.add('flex');
            document.getElementById('passwordInput').value = '';
            document.getElementById('passwordInput').focus();
        }

        function closePasswordModal() {
            document.getElementById('passwordModal').classList.remove('flex');
            document.getElementById('passwordModal').classList.add('hidden');
        }

        function verifyPassword() {
            const pass = document.getElementById('passwordInput').value;
            if (pass === 'ftm') {
                closePasswordModal();
                showAdminDashboard();
            } else {
                alert('رمز الدخول غير صحيح! الرمز الافتراضي هو ftm');
            }
        }

        function showAdminDashboard() {
            renderAdminWordsList();
            document.getElementById('adminModal').classList.remove('hidden');
            document.getElementById('adminModal').classList.add('flex');
        }

        function closeAdminModal() {
            document.getElementById('adminModal').classList.remove('flex');
            document.getElementById('adminModal').classList.add('hidden');
            initGame();
        }

        function renderAdminWordsList() {
            const listContainer = document.getElementById('adminWordsList');
            listContainer.innerHTML = '';

            if (wordsData.length === 0) {
                listContainer.innerHTML = '<p class="text-gray-400 text-center py-2 text-sm">لا توجد كلمات مضافة حالياً.</p>';
                return;
            }

            wordsData.forEach((item, index) => {
                const row = document.createElement('div');
                row.className = 'flex flex-col sm:flex-row justify-between items-start sm:items-center bg-white p-3 rounded-xl shadow-sm border border-gray-100 gap-2';
                row.innerHTML = `
                    <div class="flex gap-4 font-bold text-gray-800 text-sm sm:text-base">
                        <span>مفرد: <span class="text-sky-600">${item.singular}</span></span>
                        <span>جمع: <span class="text-pink-600">${item.plural}</span></span>
                    </div>
                    <button onclick="deleteWordPair(${item.id})" class="bg-red-100 hover:bg-red-200 text-red-600 font-bold px-3 py-1 rounded-lg text-xs sm:text-sm transition cursor-pointer">حذف</button>
                `;
                listContainer.appendChild(row);
            });
        }

        function addNewWordPair() {
            const sInput = document.getElementById('newSingular');
            const pInput = document.getElementById('newPlural');
            const sVal = sInput.value.trim();
            const pVal = pInput.value.trim();

            if (!sVal || !pVal) {
                alert('الرجاء إدخال كلمة المفرد وكلمة الجمع معاً.');
                return;
            }

            const newId = wordsData.length > 0 ? Math.max(...wordsData.map(w => w.id)) + 1 : 1;
            wordsData.push({ id: newId, singular: sVal, plural: pVal });
            saveWordsToStorage();

            sInput.value = '';
            pInput.value = '';
            renderAdminWordsList();
        }

        function deleteWordPair(id) {
            wordsData = wordsData.filter(w => w.id !== id);
            saveWordsToStorage();
            renderAdminWordsList();
        }
    </script>
</body>
</html>
